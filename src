import argparse
from pathlib import Path
import cv2
import numpy as np


def read_image(path):
    image = cv2.imread(str(path))
    if image is None:
        raise FileNotFoundError(f"Cannot open image: {path}")
    return image


def write_image(path, image):
    path.parent.mkdir(parents=True, exist_ok=True)
    if not cv2.imwrite(str(path), image):
        raise IOError(f"Could not write: {path}")


def preprocess(image):
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    smooth = cv2.GaussianBlur(gray, (5, 5), 1.15)
    return gray, smooth


def gradient_energy(gray):
    gx = cv2.Sobel(gray, cv2.CV_32F, 1, 0, 3)
    gy = cv2.Sobel(gray, cv2.CV_32F, 0, 1, 3)
    magnitude = cv2.magnitude(gx, gy)
    return cv2.normalize(magnitude, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)


def edge_map(smooth, low, high):
    return cv2.Canny(smooth, low, high)


def corner_map(image):
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    response = cv2.cornerHarris(np.float32(gray), 2, 3, 0.045)
    response = cv2.dilate(response, None)
    threshold = 0.012 * response.max()
    marked = image.copy()
    marked[response > threshold] = (0, 0, 255)
    count = int(np.count_nonzero(response > threshold))
    return marked, count


def line_map(image, edges):
    marked = image.copy()
    lines = cv2.HoughLinesP(
        edges, 1, np.pi / 180, threshold=55,
        minLineLength=55, maxLineGap=14
    )
    if lines is None:
        return marked, 0, []
    lengths = []
    for x1, y1, x2, y2 in lines[:, 0]:
        cv2.line(marked, (x1,y1), (x2,y2), (0,190,0), 2)
        lengths.append(float(np.hypot(x2-x1, y2-y1)))
    return marked, len(lines), lengths


def contour_map(image, edges):
    marked = image.copy()
    contours, _ = cv2.findContours(edges, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    areas = [cv2.contourArea(c) for c in contours]
    cv2.drawContours(marked, contours, -1, (0,215,215), 2)
    return marked, len(contours), areas


def orb_homography(reference, scene):
    g1 = cv2.cvtColor(reference, cv2.COLOR_BGR2GRAY)
    g2 = cv2.cvtColor(scene, cv2.COLOR_BGR2GRAY)
    orb = cv2.ORB_create(nfeatures=1800, fastThreshold=12)
    kp1, d1 = orb.detectAndCompute(g1, None)
    kp2, d2 = orb.detectAndCompute(g2, None)

    if d1 is None or d2 is None:
        return scene.copy(), None, 0, 0, 0

    matcher = cv2.BFMatcher(cv2.NORM_HAMMING)
    pairs = matcher.knnMatch(d1, d2, k=2)
    good = [a for a,b in pairs if a.distance < 0.74*b.distance]

    result = scene.copy()
    inliers = 0
    H = None

    if len(good) >= 4:
        p1 = np.float32([kp1[m.queryIdx].pt for m in good]).reshape(-1,1,2)
        p2 = np.float32([kp2[m.trainIdx].pt for m in good]).reshape(-1,1,2)
        H, mask = cv2.findHomography(p1, p2, cv2.RANSAC, 4.5)
        if mask is not None:
            inliers = int(mask.sum())

        if H is not None:
            h,w = reference.shape[:2]
            corners = np.float32([[0,0],[w-1,0],[w-1,h-1],[0,h-1]]).reshape(-1,1,2)
            projected = cv2.perspectiveTransform(corners,H)
            cv2.polylines(result,[np.int32(projected)],True,(0,0,255),4)

    match_image = cv2.drawMatches(
        reference, kp1, scene, kp2, good, None,
        flags=cv2.DrawMatchesFlags_NOT_DRAW_SINGLE_POINTS
    )
    return result, match_image, len(kp1), len(good), inliers


def rectified_view(reference, scene, H):
    if H is None:
        return None
    h,w = reference.shape[:2]
    inv = np.linalg.inv(H)
    return cv2.warpPerspective(scene, inv, (w,h))


def main():
    parser = argparse.ArgumentParser(
        description="Perspective-aware classical Computer Vision inspector"
    )
    parser.add_argument("--scene", required=True, help="Scene image")
    parser.add_argument("--reference", required=True, help="Reference planar object")
    parser.add_argument("--out", default="results", help="Output directory")
    parser.add_argument("--low", type=int, default=45, help="Canny lower threshold")
    parser.add_argument("--high", type=int, default=135, help="Canny upper threshold")
    args = parser.parse_args()

    out = Path(args.out)
    scene = read_image(args.scene)
    reference = read_image(args.reference)

    gray, smooth = preprocess(scene)
    energy = gradient_energy(smooth)
    edges = edge_map(smooth, args.low, args.high)
    corners, corner_count = corner_map(scene)
    lines, line_count, lengths = line_map(scene, edges)
    contours, contour_count, areas = contour_map(scene, edges)
    homography_view, matches, kp_count, good_count, inlier_count = orb_homography(reference, scene)

    write_image(out/"01_gray.png", gray)
    write_image(out/"02_smoothed.png", smooth)
    write_image(out/"03_gradient_energy.png", energy)
    write_image(out/"04_edges.png", edges)
    write_image(out/"05_harris_corners.png", corners)
    write_image(out/"06_hough_lines.png", lines)
    write_image(out/"07_contours.png", contours)
    write_image(out/"08_ransac_projection.png", homography_view)
    write_image(out/"09_orb_matches.png", matches)

    # If RANSAC found a model, rectify the scene back to the reference view.
    g1 = cv2.cvtColor(reference, cv2.COLOR_BGR2GRAY)
    g2 = cv2.cvtColor(scene, cv2.COLOR_BGR2GRAY)
    orb = cv2.ORB_create(nfeatures=1800, fastThreshold=12)
    k1,d1 = orb.detectAndCompute(g1,None)
    k2,d2 = orb.detectAndCompute(g2,None)
    H = None
    if d1 is not None and d2 is not None:
        pairs = cv2.BFMatcher(cv2.NORM_HAMMING).knnMatch(d1,d2,k=2)
        good = [a for a,b in pairs if a.distance < 0.74*b.distance]
        if len(good) >= 4:
            p1=np.float32([k1[m.queryIdx].pt for m in good]).reshape(-1,1,2)
            p2=np.float32([k2[m.trainIdx].pt for m in good]).reshape(-1,1,2)
            H,_=cv2.findHomography(p1,p2,cv2.RANSAC,4.5)
    rectified = rectified_view(reference, scene, H)
    if rectified is not None:
        write_image(out/"10_rectified_scene.png", rectified)

    mean_line = float(np.mean(lengths)) if lengths else 0.0
    max_area = float(max(areas)) if areas else 0.0
    edge_density = float(np.count_nonzero(edges) / edges.size)

    summary = f"""PERSPECTIVE-AWARE VISION INSPECTOR
====================================
Scene size: {scene.shape[1]} x {scene.shape[0]}
Canny thresholds: {args.low}, {args.high}
Edge density: {edge_density:.4f}
Harris corner candidates: {corner_count}
Hough line segments: {line_count}
Mean detected line length: {mean_line:.2f} px
External contours: {contour_count}
Largest external contour area: {max_area:.2f} px^2
Reference ORB keypoints: {kp_count}
Ratio-test matches: {good_count}
RANSAC inliers: {inlier_count}
Inlier ratio among accepted matches: {(inlier_count/good_count if good_count else 0):.4f}
"""
    (out/"summary.txt").write_text(summary,encoding="utf-8")
    print(summary)
    print(f"Results: {out.resolve()}")


if __name__ == "__main__":
    main()
